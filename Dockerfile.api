FROM node:22-bookworm-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@11.14.0 --activate

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml prisma.config.ts ./
COPY apps/api/package.json ./apps/api/package.json
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile

COPY apps/api ./apps/api

RUN pnpm --filter @bos/api build

RUN pnpm --filter @bos/api --prod deploy --legacy /prod/api && \
    SRC_CLIENT="$(readlink -f /workspace/node_modules/@prisma/client)" && \
    SRC_NODE_MODULES="$(dirname "$(dirname "$SRC_CLIENT")")" && \
    DST_CLIENT="$(readlink -f /prod/api/node_modules/@prisma/client)" && \
    DST_NODE_MODULES="$(dirname "$(dirname "$DST_CLIENT")")" && \
    mkdir -p "$DST_NODE_MODULES/.prisma" && \
    cp -R "$SRC_NODE_MODULES/.prisma/client" "$DST_NODE_MODULES/.prisma/client"


FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV PORT=8080

WORKDIR /app

COPY --from=builder --chown=node:node /prod/api ./

USER node

EXPOSE 8080

CMD ["node", "dist/main.js"]
