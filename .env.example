# NODE_ENV is managed by the framework commands (next dev/build, nest); do not set it here.

# Local Docker PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bos

# NestJS API (apps/api)
API_PORT=4000
WEB_URL=http://localhost:3000

# Next.js web (apps/web) — public API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Default UI locale: en, ru or hy
DEFAULT_LOCALE=en
