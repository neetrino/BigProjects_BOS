# Application
NODE_ENV=development

# Local Docker PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bos

# NestJS API (apps/api)
API_PORT=4000
WEB_URL=http://localhost:3000

# Next.js web (apps/web) — public API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Locale default (i18n foundation comes in a follow-up stage)
DEFAULT_LOCALE=en
