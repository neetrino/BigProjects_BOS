# NODE_ENV is managed by the framework commands (next dev/build, nest); do not set it here.

# Local Docker PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bos
# Production (Neon): pooled URL with sslmode=verify-full (not require — avoids pg SSL deprecation warning)
# and set ?connection_limit=<agreed>&pool_timeout=10 — values to be agreed at deploy time.

# NestJS API (apps/api)
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# OpenAPI UI at /api/docs (enabled when NODE_ENV !== production; set true to force-enable in production)
# SWAGGER_ENABLED=true

# Default UI locale: en, ru or hy
DEFAULT_LOCALE=hy

# First Admin seed (prisma/seed.ts / pnpm db:seed)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_NAME=Admin

# Object storage for attachments (local MinIO; production points these at Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=bos-attachments
S3_FORCE_PATH_STYLE=true

# ToonExpo integration (local stub: pnpm toonexpo:stub)
TOONEXPO_API_URL=http://localhost:4100
TOONEXPO_BOS_API_KEY=dev-local-key
