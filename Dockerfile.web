# Production image for @bos/web (Next.js standalone).
# Build context must be the monorepo root.

FROM node:22-bookworm-slim AS builder

WORKDIR /workspace

RUN npm install -g pnpm@11.14.0

ENV NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

ARG API_URL
ARG WEB_URL
ARG S3_ENDPOINT
ARG DEFAULT_LOCALE

ENV API_URL=$API_URL \
    WEB_URL=$WEB_URL \
    S3_ENDPOINT=$S3_ENDPOINT \
    DEFAULT_LOCALE=$DEFAULT_LOCALE

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml prisma.config.ts ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile

COPY apps/web ./apps/web

RUN pnpm --filter @bos/web build \
    && test -f apps/web/.next/standalone/apps/web/server.js \
    && mkdir -p apps/web/public

FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=builder --chown=node:node /workspace/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /workspace/apps/web/public ./apps/web/public

USER node

EXPOSE 3000

HEALTHCHECK --interval=5s --timeout=5s --start-period=60s --retries=10 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/ready').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "apps/web/server.js"]
