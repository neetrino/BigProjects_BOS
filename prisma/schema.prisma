generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EventCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum OrganizationType {
  BUILDER
  BANK
  PARTNER
  OTHER
}

enum DealStage {
  NEW
  CONTACTED
  NEGOTIATION
  WON
  LOST
}

enum PartnerStage {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

enum ContentOwnerType {
  ORGANIZATION
  BUILDER_DEAL
  PARTNER_PARTICIPATION
}

enum PublicDisplayMode {
  ORGANIZATION
  CUSTOM_LABEL
  HIDDEN
}

enum PlanPublishStatus {
  UNPUBLISHED
  PUBLISHED
}

enum ToonExpoRequestStatus {
  PENDING
  SUCCESS
  LINKED_EXISTING
  FAILED
}

enum VenueMapPublicationStatus {
  PENDING
  PUBLISHED
  ALREADY_PUBLISHED
  REJECTED
  FAILED
}

model User {
  id                            String                 @id @default(cuid())
  name                          String
  email                         String                 @unique
  passwordHash                  String
  role                          UserRole
  status                        UserStatus
  locale                        String                 @default("hy")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  sessions                      Session[]
  assignedBuilderDeals          BuilderDeal[]          @relation("AssignedStaff")
  assignedPartnerParticipations PartnerParticipation[] @relation("AssignedPartnerStaff")
  authoredNotes                 Note[]
  uploadedAttachments           Attachment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EventCycle {
  id                           String                        @id @default(cuid())
  name                         String
  code                         String                        @unique
  status                       EventCycleStatus              @default(DRAFT)
  startsAt                     DateTime?
  endsAt                       DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  builderDeals                 BuilderDeal[]
  partnerParticipations        PartnerParticipation[]
  venuePlan                    VenuePlan?
  toonExpoProvisioningRequests ToonExpoProvisioningRequest[]
}

model Organization {
  id                           String                        @id @default(cuid())
  name                         String
  type                         OrganizationType
  registrationId               String?
  phone                        String?
  email                        String?
  website                      String?
  toonexpoCompanyId            String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  contacts                     Contact[]
  builderDeals                 BuilderDeal[]
  partnerParticipations        PartnerParticipation[]
  toonExpoProvisioningRequests ToonExpoProvisioningRequest[]
}

model Contact {
  id                    String                 @id @default(cuid())
  organizationId        String
  name                  String
  phone                 String?
  email                 String?
  position              String?
  isPrimary             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  builderDeals          BuilderDeal[]
  partnerParticipations PartnerParticipation[]

  @@index([organizationId])
}

model BuilderDeal {
  id               String    @id @default(cuid())
  eventCycleId     String
  organizationId   String
  primaryContactId String?
  assignedStaffId  String?
  stage            DealStage @default(NEW)
  expectedSqm      Int?
  agreedAmount     Decimal?  @db.Decimal(12, 2)
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  eventCycle       EventCycle        @relation(fields: [eventCycleId], references: [id], onDelete: Restrict)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryContact   Contact?          @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  assignedStaff    User?             @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  spaceAllocations SpaceAllocation[]

  @@index([eventCycleId])
  @@index([organizationId])
  @@index([assignedStaffId])
}

model PartnerParticipation {
  id               String       @id @default(cuid())
  eventCycleId     String
  organizationId   String
  primaryContactId String?
  assignedStaffId  String?
  stage            PartnerStage @default(NEW)
  partnerType      String?
  description      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  eventCycle       EventCycle        @relation(fields: [eventCycleId], references: [id], onDelete: Restrict)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryContact   Contact?          @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  assignedStaff    User?             @relation("AssignedPartnerStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  spaceAllocations SpaceAllocation[]

  @@index([eventCycleId])
  @@index([organizationId])
  @@index([assignedStaffId])
}

model VenuePlan {
  id             String            @id @default(cuid())
  eventCycleId   String            @unique
  title          String
  imageKey       String?
  imageWidth     Int?
  imageHeight    Int?
  pixelsPerMeter Float?
  gridOriginX    Float             @default(0)
  gridOriginY    Float             @default(0)
  publishStatus  PlanPublishStatus @default(UNPUBLISHED)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  eventCycle           EventCycle            @relation(fields: [eventCycleId], references: [id], onDelete: Restrict)
  spaceAreas           SpaceArea[]
  spaceAreaCells       SpaceAreaCell[]
  venueMapPublications VenueMapPublication[]
}

model SpaceArea {
  id                String            @id @default(cuid())
  venuePlanId       String
  code              String?
  name              String
  squareMeters      Int
  publicDisplayMode PublicDisplayMode @default(ORGANIZATION)
  customPublicLabel String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  venuePlan   VenuePlan         @relation(fields: [venuePlanId], references: [id], onDelete: Cascade)
  cells       SpaceAreaCell[]
  allocations SpaceAllocation[]

  @@index([venuePlanId])
}

model SpaceAreaCell {
  id          String @id @default(cuid())
  spaceAreaId String
  venuePlanId String
  x           Int
  y           Int

  spaceArea SpaceArea @relation(fields: [spaceAreaId], references: [id], onDelete: Cascade)
  venuePlan VenuePlan @relation(fields: [venuePlanId], references: [id], onDelete: Cascade)

  @@unique([venuePlanId, x, y])
  @@index([spaceAreaId])
}

model SpaceAllocation {
  id                     String    @id @default(cuid())
  spaceAreaId            String
  builderDealId          String?
  partnerParticipationId String?
  active                 Boolean   @default(true)
  assignedAt             DateTime  @default(now())
  releasedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  spaceArea            SpaceArea             @relation(fields: [spaceAreaId], references: [id], onDelete: Restrict)
  builderDeal          BuilderDeal?          @relation(fields: [builderDealId], references: [id], onDelete: Restrict)
  partnerParticipation PartnerParticipation? @relation(fields: [partnerParticipationId], references: [id], onDelete: Restrict)

  @@index([spaceAreaId])
  @@index([builderDealId])
  @@index([partnerParticipationId])
}

model Note {
  id        String           @id @default(cuid())
  ownerType ContentOwnerType
  ownerId   String
  body      String           @db.Text
  authorId  String
  createdAt DateTime         @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId])
}

model Attachment {
  id               String           @id @default(cuid())
  ownerType        ContentOwnerType
  ownerId          String
  originalFilename String
  objectKey        String           @unique
  contentType      String
  size             Int
  uploaderId       String
  createdAt        DateTime         @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId])
}

/// One row per outbound ToonExpo account-provisioning attempt. `id` doubles as the wire
/// `request_id`, which ToonExpo replays idempotently, so a manual retry re-sends the same id.
model ToonExpoProvisioningRequest {
  id                String                @id @default(cuid())
  organizationId    String
  eventCycleId      String
  companyType       OrganizationType
  contactName       String
  contactEmail      String
  contactPhone      String?
  requestedModules  String[]
  status            ToonExpoRequestStatus @default(PENDING)
  toonexpoCompanyId String?
  toonexpoUserId    String?
  errorMessage      String?
  attemptCount      Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventCycle   EventCycle   @relation(fields: [eventCycleId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

/// One row per attempted ToonExpo venue-map snapshot publication. `id` doubles as the wire
/// `request_id`. Unchanged content re-publishes the same `snapshotVersion` (idempotent replay);
/// changed content gets the next version.
model VenueMapPublication {
  id                 String                    @id @default(cuid())
  venuePlanId        String
  snapshotVersion    Int
  checksum           String
  status             VenueMapPublicationStatus @default(PENDING)
  toonexpoSnapshotId String?
  errorMessage       String?
  publishedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  venuePlan VenuePlan @relation(fields: [venuePlanId], references: [id], onDelete: Restrict)

  @@unique([venuePlanId, snapshotVersion])
  @@index([venuePlanId])
}
