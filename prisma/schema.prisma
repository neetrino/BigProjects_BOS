generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EventCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum OrganizationType {
  BUILDER
  BANK
  PARTNER
  OTHER
}

enum DealStage {
  NEW
  CONTACTED
  NEGOTIATION
  WON
  LOST
}

enum PartnerStage {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

enum ContentOwnerType {
  ORGANIZATION
  BUILDER_DEAL
  PARTNER_PARTICIPATION
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus
  locale       String     @default("hy")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  sessions                     Session[]
  assignedBuilderDeals         BuilderDeal[]            @relation("AssignedStaff")
  assignedPartnerParticipations PartnerParticipation[]  @relation("AssignedPartnerStaff")
  authoredNotes                Note[]
  uploadedAttachments          Attachment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EventCycle {
  id        String           @id @default(cuid())
  name      String
  code      String           @unique
  status    EventCycleStatus @default(DRAFT)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  builderDeals           BuilderDeal[]
  partnerParticipations  PartnerParticipation[]
}

model Organization {
  id                String           @id @default(cuid())
  name              String
  type              OrganizationType
  registrationId    String?
  phone             String?
  email             String?
  website           String?
  toonexpoCompanyId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  contacts              Contact[]
  builderDeals          BuilderDeal[]
  partnerParticipations PartnerParticipation[]
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  position       String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  builderDeals          BuilderDeal[]
  partnerParticipations PartnerParticipation[]

  @@index([organizationId])
}

model BuilderDeal {
  id               String     @id @default(cuid())
  eventCycleId     String
  organizationId   String
  primaryContactId String?
  assignedStaffId  String?
  stage            DealStage  @default(NEW)
  expectedSqm      Int?
  agreedAmount     Decimal?   @db.Decimal(12, 2)
  description      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  eventCycle     EventCycle   @relation(fields: [eventCycleId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryContact Contact?     @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  assignedStaff  User?        @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([eventCycleId])
  @@index([organizationId])
  @@index([assignedStaffId])
}

model PartnerParticipation {
  id               String       @id @default(cuid())
  eventCycleId     String
  organizationId   String
  primaryContactId String?
  assignedStaffId  String?
  stage            PartnerStage @default(NEW)
  partnerType      String?
  description      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  eventCycle     EventCycle   @relation(fields: [eventCycleId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryContact Contact?     @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  assignedStaff  User?        @relation("AssignedPartnerStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([eventCycleId])
  @@index([organizationId])
  @@index([assignedStaffId])
}

model Note {
  id        String           @id @default(cuid())
  ownerType ContentOwnerType
  ownerId   String
  body      String           @db.Text
  authorId  String
  createdAt DateTime         @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId])
}

model Attachment {
  id               String           @id @default(cuid())
  ownerType        ContentOwnerType
  ownerId          String
  originalFilename String
  objectKey        String           @unique
  contentType      String
  size             Int
  uploaderId       String
  createdAt        DateTime         @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId])
}
